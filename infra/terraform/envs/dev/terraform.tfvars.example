aws_region  = "ap-northeast-2"
aws_profile = "umcproduct-admin"
environment = "dev"

shared_state_bucket = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
shared_state_key    = "umc-product-server/shared/terraform.tfstate"
shared_state_region = "ap-northeast-2"

dev_secret_source              = "local_env_file"
dev_runtime_env_file_path      = "/etc/umc-product/dev.env"
dev_ssm_parameter_path         = null
dev_runtime_secret_arn         = null
dev_runtime_secret_kms_key_arn = null
image_tag                      = "REPLACE_WITH_IMAGE_TAG"
