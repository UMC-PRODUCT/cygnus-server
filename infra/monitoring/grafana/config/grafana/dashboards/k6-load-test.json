{
  "uid": "k6-load-test",
  "title": "부하 테스트 (k6)",
  "description": "k6 remote-write 지표 대시보드. 실행: loadtest/scripts/run-k6.sh — SUT 리소스는 node-exporter-host, 앱 내부는 server-default 대시보드와 같이 본다.",
  "tags": [
    "load-test",
    "k6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "요청 처리량 (RPS, 시나리오별)",
      "description": "k6 가 보낸 초당 요청 수. RATE 를 올렸는데 여기가 안 오르면 생성기/SUT 어딘가가 포화된 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "응답시간 p95 / p99 (시나리오별, ms)",
      "description": "시나리오(요청 태그)별 p95/p99. SLO 판정 기준.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "k6_http_req_duration_p95",
          "legendFormat": "p95 {{scenario}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "k6_http_req_duration_p99",
          "legendFormat": "p99 {{scenario}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "시나리오 에러율 (umc_scenario_errors)",
      "description": "상태코드 체크 실패 비율(시나리오별 커스텀 Rate). 0 이어야 정상.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "k6_umc_scenario_errors_rate",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
