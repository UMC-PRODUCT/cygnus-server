"""
판정 이력 Connection. asOf/progressStatus는 목록의 구조 필터 기준 헤더 집계다.
"""
type RecruitingDecisionHistoryConnection {
  edges: [RecruitingDecisionHistoryEdge!]!
  pageInfo: PageInfo!
  totalCount: Long!
  asOf: Instant!
  progressStatus: RecruitingEvaluationProgressStatus!
}

type RecruitingDecisionHistoryEdge {
  cursor: String!
  node: RecruitingDecisionHistory!
}

enum ChallengerTrack {
  PLAN
  DESIGN
  WEB_PRODUCT_ENGINEER
  MOBILE_PRODUCT_ENGINEER
  INFRA_PLUS
}

enum RecruitingRoundType {
  REGULAR
  ADDITIONAL
}

enum RecruitingRoundStatus {
  DRAFT
  OPEN
  CLOSED
}

enum RecruitingApplicationStatus {
  DRAFT
  SUBMITTED
  DOCUMENT_FAILED
  INTERVIEW_ASSIGNED
  INTERVIEW_SKIPPED
  FINAL_PASSED
  FINAL_FAILED
  CANCELLED
}

enum RecruitingApplicationRegistrationStatus {
  NOT_READY
  READY
  REGISTERED
}

enum RecruitingDecisionResult {
  PASSED
  FAILED
}

enum RecruitingDecisionHistorySortOrder {
  LATEST
  OLDEST
}

enum RecruitingEvaluationProgressStatus {
  BEFORE_EVALUATION
  IN_PROGRESS
  COMPLETED
}

enum ChallengerRoleType {
  CENTRAL_PRESIDENT
  CENTRAL_VICE_PRESIDENT
  CENTRAL_OPERATING_TEAM_MEMBER
  CENTRAL_EDUCATION_TEAM_MEMBER
  CHAPTER_PRESIDENT
  SCHOOL_PRESIDENT
  SCHOOL_VICE_PRESIDENT
  SCHOOL_PART_LEADER
  SCHOOL_ETC_ADMIN
}

enum RecruitingDecisionStatus {
  PASS
  FAIL
}

enum RecruitingEvaluatorStage {
  DOCUMENT
  INTERVIEW
}

enum RecruitingApplicationEvaluationDecision {
  APPROVED
  REJECTED
}

enum RecruitingFormSectionType {
  COMMON
  TRACK
}

enum RecruitingInterviewScheduleStatus {
  AVAILABILITY_REQUESTED
  AVAILABILITY_SUBMITTED
  CONFIRMED
  CANCELLED
}

enum RecruitingRoundPhase {
  OPEN
  PAST
}

enum RecruitingRoundSort {
  NEWEST
  REGISTERED
  RECRUITMENT
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RecruitingPublicResultStatus {
  PENDING
  APPROVED
  REJECTED
}
