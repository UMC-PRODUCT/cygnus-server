}

type RecruitingDecisionHistoryPage {
  asOf: Instant!
  progressStatus: RecruitingEvaluationProgressStatus!
  content: [RecruitingDecisionHistory!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
}

type RecruitingDecisionHistory {
  decisionHistoryId: ID!
  applicationId: ID!
  decidedAt: Instant!
  decisionStatus: RecruitingApplicationStatus!
  result: RecruitingDecisionResult!
  applicant: RecruitingDecisionHistoryApplicant!
  decider: RecruitingDecisionHistoryDecider!
}

type RecruitingDecisionHistoryApplicant {
  chapterId: ID!
  chapterName: String!
  schoolId: ID!
  schoolName: String!
  name: String!
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
  acceptedTrack: ChallengerTrack
}

type RecruitingDecisionHistoryDecider {
  memberId: ID!
  chapterId: ID
  chapterName: String
  schoolId: ID
  schoolName: String
  roleType: ChallengerRoleType
  name: String
  nickname: String
}

type RecruitingApplicationReview {
  applicationId: ID!
  applicantName: String!
  email: String!
  applicantMemberId: ID
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
  acceptedTrack: ChallengerTrack
  status: RecruitingApplicationStatus!
  registrationStatus: RecruitingApplicationRegistrationStatus!
  submittedAt: Instant!
  documentEvaluatedByMe: Boolean!
  interviewEvaluatedByMe: Boolean!
}

type RecruitingApplicationReviewDetail {
  application: RecruitingApplicationReview!
  formResponseId: ID!
  answers: [RecruitingApplicationReviewAnswer!]!
}

type RecruitingApplicationReviewAnswer {
  questionId: ID!
  type: QuestionType!
  textValue: String
  selectedOptions: [RecruitingApplicationReviewSelectedOption!]!
  fileIds: [String!]!
  times: [Instant!]!
}

type RecruitingApplicationReviewSelectedOption {
  questionOptionId: ID
  answeredAsContent: String!
}

type RecruitingIdPayload {
  id: ID!
}

enum ChallengerTrack {
  PLAN
  DESIGN
  WEB_PRODUCT_ENGINEER
  MOBILE_PRODUCT_ENGINEER
  INFRA_PLUS
}

enum RecruitingRoundType {
  REGULAR
  ADDITIONAL
}

enum RecruitingRoundStatus {
  DRAFT
  OPEN
  CLOSED
}

enum RecruitingApplicationFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RecruitingApplicationStatus {
  DRAFT
  SUBMITTED
  DOCUMENT_FAILED
  INTERVIEW_ASSIGNED
  INTERVIEW_SKIPPED
  FINAL_PASSED
  FINAL_FAILED
  CANCELLED
}

enum RecruitingApplicationRegistrationStatus {
  NOT_READY
  READY
  REGISTERED
}

enum RecruitingDecisionResult {
  PASSED
  FAILED
}

enum RecruitingDecisionHistorySortOrder {
  LATEST
  OLDEST
}

enum RecruitingEvaluationProgressStatus {
  BEFORE_EVALUATION
  IN_PROGRESS
  COMPLETED
}

enum ChallengerRoleType {
  CENTRAL_PRESIDENT
  CENTRAL_VICE_PRESIDENT
  CENTRAL_OPERATING_TEAM_MEMBER
  CENTRAL_EDUCATION_TEAM_MEMBER
  CHAPTER_PRESIDENT
  SCHOOL_PRESIDENT
  SCHOOL_VICE_PRESIDENT
  SCHOOL_PART_LEADER
  SCHOOL_ETC_ADMIN
}

enum RecruitingDecisionStatus {
  PASS
  FAIL
}

enum RecruitingEvaluatorStage {
  DOCUMENT
  INTERVIEW
}

enum RecruitingApplicationEvaluationDecision {
  APPROVED
  REJECTED
}

enum RecruitingFormSectionType {
  COMMON
  TRACK
}

enum RecruitingInterviewScheduleStatus {
  AVAILABILITY_REQUESTED
  AVAILABILITY_SUBMITTED
  CONFIRMED
  CANCELLED
}

enum RecruitingRoundPhase {
  OPEN
  PAST
}

enum RecruitingRoundSort {
  NEWEST
  REGISTERED
  RECRUITMENT
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RecruitingPublicResultStatus {
  PENDING
  APPROVED
  REJECTED
}
