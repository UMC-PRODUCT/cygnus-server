scalar Instant

extend type Query {
  publicRecruitingRounds(
    input: RecruitingPublicRoundSearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingPublicRoundGroupConnection!
  recruitingApplicationFormStructure(
    applicationFormId: ID!
    input: RecruitingApplicationFormStructureInput!
  ): RecruitingApplicationFormStructure!
  recruitingApplicationByCredential(
    input: RecruitingApplicationCredentialInput!
  ): RecruitingPublicApplication!
  recruitingApplication(applicationId: ID!): RecruitingApplication!
  recruitingRoundGroups(
    input: RecruitingRoundSearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingSeasonSummaryConnection!
  recruitingRoundTitleAvailable(seasonId: ID!, title: String!, excludedRoundId: ID): Boolean!
  recruitingSeason(id: ID!): RecruitingSeason!
  recruitingRoundEvaluators(
    seasonId: ID!
    roundId: ID!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingRoundEvaluatorConnection!
  recruitingRoundInterviewQuestions(
    seasonId: ID!
    roundId: ID!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingRoundInterviewQuestionConnection!
  recruitingApplicationInterviewQuestions(
    seasonId: ID!
    applicationId: ID!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingApplicationInterviewQuestionConnection!
  recruitingApplicationEvaluations(
    applicationId: ID!
    stage: RecruitingEvaluatorStage!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingApplicationEvaluationConnection!
  recruitingInterviewSchedule(applicationId: ID!): RecruitingInterviewSchedule
  recruitingInterviewSession(seasonId: ID!, roundId: ID!, sessionId: ID!): RecruitingInterviewSession!
  recruitingInterviewSessions(
    seasonId: ID!
    roundId: ID!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingInterviewSessionConnection!
  recruitingInterviewScheduleBoard(
    seasonId: ID!
    roundId: ID!
    date: String!
  ): RecruitingInterviewScheduleBoard!
  recruitingStatusSummary(input: RecruitingStatusSummaryInput!): RecruitingStatusSummary!
  recruitingEvaluationStatistics(input: RecruitingEvaluationStatisticsInput!): RecruitingEvaluationStatistics!
  recruitingDecisionHistories(
    input: RecruitingDecisionHistorySearchInput!
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingDecisionHistoryConnection!
  recruitingRoundApplications(
    roundId: ID!
    input: RecruitingApplicationSearchInput
    first: Int
    after: String
    last: Int
    before: String
  ): RecruitingApplicationReviewConnection!
  recruitingRoundApplication(roundId: ID!, applicationId: ID!): RecruitingApplicationReviewDetail!
}

type Mutation {
  createRecruitingSeason(input: CreateRecruitingSeasonInput!): CreateRecruitingSeasonPayload!
  updateRecruitingSeason(input: UpdateRecruitingSeasonInput!): UpdateRecruitingSeasonPayload!
  replaceRecruitingSeasonTrackQuotas(
    input: ReplaceRecruitingSeasonTrackQuotasInput!
  ): ReplaceRecruitingSeasonTrackQuotasPayload!
  createRecruitingRound(input: CreateRecruitingRoundInput!): CreateRecruitingRoundPayload!
  updateRecruitingRoundStatus(input: UpdateRecruitingRoundStatusInput!): UpdateRecruitingRoundStatusPayload!
  updateRecruitingRound(input: UpdateRecruitingRoundInput!): UpdateRecruitingRoundPayload!
  upsertRecruitingApplicationForm(
    input: UpsertRecruitingApplicationFormInput!
  ): UpsertRecruitingApplicationFormPayload!
  cloneRecruitingRound(input: CloneRecruitingRoundInput!): CloneRecruitingRoundPayload!
  deleteRecruitingRound(input: DeleteRecruitingRoundInput!): DeleteRecruitingRoundPayload!
  addRecruitingRoundEvaluator(input: AddRecruitingRoundEvaluatorInput!): AddRecruitingRoundEvaluatorPayload!
  removeRecruitingRoundEvaluator(input: RemoveRecruitingRoundEvaluatorInput!): RemoveRecruitingRoundEvaluatorPayload!
  createRecruitingRoundInterviewQuestion(
    input: CreateRecruitingRoundInterviewQuestionInput!
  ): CreateRecruitingRoundInterviewQuestionPayload!
  updateRecruitingRoundInterviewQuestion(
    input: UpdateRecruitingRoundInterviewQuestionInput!
  ): UpdateRecruitingRoundInterviewQuestionPayload!
  deactivateRecruitingRoundInterviewQuestion(
    input: DeactivateRecruitingRoundInterviewQuestionInput!
  ): DeactivateRecruitingRoundInterviewQuestionPayload!
  createRecruitingApplicationInterviewQuestion(
    input: CreateRecruitingApplicationInterviewQuestionInput!
  ): CreateRecruitingApplicationInterviewQuestionPayload!
  updateRecruitingApplicationInterviewQuestion(
    input: UpdateRecruitingApplicationInterviewQuestionInput!
  ): UpdateRecruitingApplicationInterviewQuestionPayload!
  deactivateRecruitingApplicationInterviewQuestion(
    input: DeactivateRecruitingApplicationInterviewQuestionInput!
  ): DeactivateRecruitingApplicationInterviewQuestionPayload!
  createRecruitingApplicationDraft(
    input: CreateRecruitingApplicationDraftInput!
  ): CreateRecruitingApplicationDraftPayload!
  createAnonymousRecruitingApplicationDraft(
    input: CreateAnonymousRecruitingApplicationDraftInput!
  ): CreateAnonymousRecruitingApplicationDraftPayload!
  updateRecruitingApplicationDraft(
    input: UpdateRecruitingApplicationDraftInput!
  ): UpdateRecruitingApplicationDraftPayload!
  updateAnonymousRecruitingApplication(
    input: UpdateAnonymousRecruitingApplicationInput!
  ): UpdateAnonymousRecruitingApplicationPayload!
  submitRecruitingApplication(input: SubmitRecruitingApplicationInput!): SubmitRecruitingApplicationPayload!
  submitAnonymousRecruitingApplication(
    input: SubmitAnonymousRecruitingApplicationInput!
  ): SubmitAnonymousRecruitingApplicationPayload!
  cancelRecruitingApplication(input: CancelRecruitingApplicationInput!): CancelRecruitingApplicationPayload!
  cancelAnonymousRecruitingApplication(
    input: RecruitingApplicationCredentialInput!
  ): CancelAnonymousRecruitingApplicationPayload!
  decideRecruitingDocument(input: DecideRecruitingDocumentInput!): DecideRecruitingDocumentPayload!
  decideRecruitingFinal(input: DecideRecruitingFinalInput!): DecideRecruitingFinalPayload!
  prepareRecruitingRegistration(input: PrepareRecruitingRegistrationInput!): PrepareRecruitingRegistrationPayload!
  cancelRecruitingRegistration(input: CancelRecruitingRegistrationInput!): CancelRecruitingRegistrationPayload!
  confirmRecruitingRegistration(input: ConfirmRecruitingRegistrationInput!): ConfirmRecruitingRegistrationPayload!
  skipRecruitingInterview(input: SkipRecruitingInterviewInput!): SkipRecruitingInterviewPayload!
  requestRecruitingInterviewAvailability(
    input: RequestRecruitingInterviewAvailabilityInput!
  ): RequestRecruitingInterviewAvailabilityPayload!
  submitRecruitingInterviewAvailability(
    input: SubmitRecruitingInterviewAvailabilityInput!
  ): SubmitRecruitingInterviewAvailabilityPayload!
  confirmRecruitingInterviewSchedule(
    input: ConfirmRecruitingInterviewScheduleInput!
  ): ConfirmRecruitingInterviewSchedulePayload!
  createRecruitingInterviewSession(
    input: CreateRecruitingInterviewSessionInput!
  ): CreateRecruitingInterviewSessionPayload!
  updateRecruitingInterviewSession(
    input: UpdateRecruitingInterviewSessionInput!
  ): UpdateRecruitingInterviewSessionPayload!
  deleteRecruitingInterviewSession(
    input: DeleteRecruitingInterviewSessionInput!
  ): DeleteRecruitingInterviewSessionPayload!
  confirmRecruitingInterviewSchedules(
    input: ConfirmRecruitingInterviewSchedulesInput!
  ): ConfirmRecruitingInterviewSchedulesPayload!
  submitRecruitingApplicationEvaluation(
    input: SubmitRecruitingApplicationEvaluationInput!
  ): SubmitRecruitingApplicationEvaluationPayload!
}

