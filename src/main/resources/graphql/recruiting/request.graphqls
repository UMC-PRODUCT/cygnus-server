extend type Query {
  """운영자가 접근 가능한 Recruiting season을 조직 조건으로 조회한다."""
  recruitingSeasons(filter: RecruitingSeasonFilter!): [RecruitingSeason!]!
  """Recruiting season 단건을 조회한다."""
  recruitingSeason(id: ID!): RecruitingSeason
  """지원자에게 공개된 Recruiting round를 조건으로 조회한다."""
  recruitingRounds(filter: RecruitingRoundFilter!): [RecruitingRound!]!
  """지원자에게 공개되었거나 운영 권한이 있는 Recruiting round를 조회한다."""
  recruitingRound(id: ID!): RecruitingRound
  """인증 회원 ID 또는 비회원 credential로 Recruiting 지원서를 조회한다."""
  recruitingApplication(access: RecruitingApplicationAccessInput!): RecruitingApplication
}

extend type Mutation {
  createRecruitingSeason(input: CreateRecruitingSeasonInput!): RecruitingSeason!
  updateRecruitingSeason(id: ID!, input: UpdateRecruitingSeasonInput!): RecruitingSeason!
  createRecruitingRound(seasonId: ID!, input: CreateRecruitingRoundInput!): RecruitingRound!
  updateRecruitingRound(id: ID!, input: UpdateRecruitingRoundInput!): RecruitingRound!
  changeRecruitingRoundStatus(id: ID!, status: RecruitingRoundStatus!): RecruitingRound!
  cloneRecruitingRound(id: ID!, input: CloneRecruitingRoundInput!): RecruitingRound!
  deleteRecruitingRound(id: ID!): RecruitingDeletedPayload!
  upsertRecruitingApplicationForm(
    roundId: ID!
    input: UpsertRecruitingApplicationFormInput!
  ): RecruitingRound!
  setRecruitingRoundEvaluators(roundId: ID!, memberIds: [ID!]!): RecruitingRound!
  replaceRecruitingRoundInterviewQuestions(
    roundId: ID!
    questions: [RecruitingInterviewQuestionReplacementInput!]!
  ): RecruitingRound!
  replaceRecruitingApplicationInterviewQuestions(
    applicationId: ID!
    questions: [RecruitingInterviewQuestionReplacementInput!]!
  ): RecruitingApplication!
  createRecruitingApplication(
    input: CreateRecruitingApplicationInput!
  ): RecruitingApplicationCreatedPayload!
  updateRecruitingApplication(
    access: RecruitingApplicationAccessInput!
    input: UpdateRecruitingApplicationInput!
  ): RecruitingApplication!
  submitRecruitingApplication(
    access: RecruitingApplicationAccessInput!
    input: SubmitRecruitingApplicationInput
  ): RecruitingApplication!
  cancelRecruitingApplication(
    access: RecruitingApplicationAccessInput!
    input: CancelRecruitingApplicationInput
  ): RecruitingApplication!
  decideRecruitingDocument(
    applicationId: ID!
    input: RecruitingDocumentDecisionInput!
  ): RecruitingApplication!
  decideRecruitingFinal(
    applicationId: ID!
    input: RecruitingFinalDecisionInput!
  ): RecruitingApplication!
  prepareRecruitingRegistration(applicationId: ID!): RecruitingApplication!
  cancelRecruitingRegistration(applicationId: ID!): RecruitingApplication!
  confirmRecruitingRegistration(applicationId: ID!): RecruitingApplication!
  skipRecruitingInterview(
    applicationId: ID!
    input: SkipRecruitingInterviewInput
  ): RecruitingApplication!
  requestRecruitingInterviewAvailability(
    applicationId: ID!
    input: RequestRecruitingInterviewAvailabilityInput!
  ): RecruitingApplication!
  submitRecruitingInterviewAvailability(
    access: RecruitingApplicationAccessInput!
  ): RecruitingApplication!
  confirmRecruitingInterviewSchedule(
    applicationId: ID!
    input: ConfirmRecruitingInterviewScheduleInput!
  ): RecruitingApplication!
  submitRecruitingApplicationEvaluation(
    applicationId: ID!
    input: RecruitingApplicationEvaluationInput!
  ): RecruitingApplication!
}

"""운영자가 Recruiting season을 찾는 조직 조건."""
input RecruitingSeasonFilter {
  gisuId: ID!
  chapterId: ID
  schoolId: ID
}

"""지원자가 공개 Recruiting round를 찾는 조건."""
input RecruitingRoundFilter {
  gisuId: ID!
  chapterId: ID
  schoolIds: [ID!]
  roundIds: [ID!]
  schoolName: String
  seasonId: ID
  track: ChallengerTrack
  phase: RecruitingRoundPhase
  sort: RecruitingRoundSort
}

"""회원 또는 비회원 지원서 접근 정보. 두 방식 중 정확히 하나만 지정해야 한다."""
input RecruitingApplicationAccessInput {
  applicationId: ID
  credential: RecruitingApplicationCredentialInput
}

"""비회원 지원서를 식별하는 자격 정보."""
input RecruitingApplicationCredentialInput {
  email: String!
  applicationKey: String!
}

input RecruitingApplicationFormStructureInput {
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
}

input RecruitingSeasonManagementSummaryInput {
  schoolIds: [ID!]
  roundIds: [ID!]
  schoolName: String
}

input RecruitingApplicationSearchInput {
  statuses: [RecruitingApplicationStatus!]
  tracks: [ChallengerTrack!]
}

input CreateRecruitingSeasonInput {
  gisuId: ID!
  schoolId: ID!
  quotas: [RecruitingSeasonTrackQuotaInput!]!
}

input UpdateRecruitingSeasonInput {
  memo: String
  quotas: [RecruitingSeasonTrackQuotaInput!]!
}

input RecruitingSeasonTrackQuotaInput {
  track: ChallengerTrack!
  targetCount: Int!
}

input CreateRecruitingRoundInput {
  title: String!
  type: RecruitingRoundType!
  roundNo: Int
  recruitableTracks: [ChallengerTrack!]!
  secondChoiceEnabled: Boolean!
  documentStartAt: Instant!
  documentEndAt: Instant!
  documentResultPublishedAt: Instant!
  interviewRequired: Boolean!
  interviewStartAt: Instant
  interviewEndAt: Instant
  finalResultPublishedAt: Instant!
  availabilityFormId: ID
  announcement: String
  contactText: String
}

input UpdateRecruitingRoundInput {
  title: String!
  recruitableTracks: [ChallengerTrack!]!
  secondChoiceEnabled: Boolean!
  documentStartAt: Instant!
  documentEndAt: Instant!
  documentResultPublishedAt: Instant!
  interviewRequired: Boolean!
  interviewStartAt: Instant
  interviewEndAt: Instant
  finalResultPublishedAt: Instant!
  availabilityFormId: ID
  announcement: String
  contactText: String
}

input CloneRecruitingRoundInput {
  targetSeasonId: ID!
  title: String!
  type: RecruitingRoundType!
  roundNo: Int
}

input UpsertRecruitingApplicationFormInput {
  description: String
  sections: [UpsertRecruitingFormSectionInput!]!
}

input UpsertRecruitingFormSectionInput {
  sectionId: ID
  clientKey: String!
  title: String!
  description: String
  type: RecruitingFormSectionType!
  track: ChallengerTrack
  questions: [UpsertRecruitingFormQuestionInput!]!
}

input UpsertRecruitingFormQuestionInput {
  questionId: ID
  type: QuestionType!
  title: String!
  description: String
  required: Boolean!
  options: [UpsertRecruitingFormOptionInput!]!
}

input UpsertRecruitingFormOptionInput {
  optionId: ID
  content: String!
  other: Boolean!
  nextSectionKey: String
}

"""ID가 있으면 기존 질문을 수정하고, 없으면 생성한다. 요청에서 누락된 기존 질문은 비활성화한다."""
input RecruitingInterviewQuestionReplacementInput {
  id: ID
  content: String!
  orderNo: Int!
}

"""인증 여부에 따라 회원 또는 비회원 지원서 초안을 생성한다."""
input CreateRecruitingApplicationInput {
  applicationFormId: ID!
  applicantName: String!
  applicantEmail: String!
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
  privacyTermId: ID
  privacyAgreed: Boolean
}

input UpdateRecruitingApplicationInput {
  applicantName: String!
  applicantEmail: String!
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
  answers: [RecruitingAnswerInput!]!
}

input RecruitingAnswerInput {
  questionId: ID!
  textValue: String
  selectedOptionIds: [ID!]!
  fileIds: [String!]!
}

input SubmitRecruitingApplicationInput {
  submittedIp: String
}

input CancelRecruitingApplicationInput {
  reason: String
}

input RecruitingDocumentDecisionInput {
  decision: RecruitingDecisionStatus!
  reason: String
}

input RecruitingFinalDecisionInput {
  decision: RecruitingDecisionStatus!
  acceptedTrack: ChallengerTrack
  reason: String
}

input SkipRecruitingInterviewInput {
  reason: String
}

input RequestRecruitingInterviewAvailabilityInput {
  contactSnapshot: String!
}

input ConfirmRecruitingInterviewScheduleInput {
  startsAt: Instant!
  endsAt: Instant!
  location: String
  contactSnapshot: String!
}

input RecruitingApplicationEvaluationInput {
  stage: RecruitingEvaluatorStage!
  decision: RecruitingApplicationEvaluationDecision!
  comment: String
}
