"""Recruiting이 외부에 제공하는 canonical season resource."""
type RecruitingSeason {
  id: ID!
  gisu: Gisu!
  school: School!
  rounds: [RecruitingRound!]!
  """Recruitment READ 권한이 있을 때만 제공하는 운영 정보."""
  management: RecruitingSeasonManagement
}

type RecruitingSeasonManagement {
  memo: String
  quotas: [RecruitingSeasonTrackQuota!]!
  roundTitleAvailable(title: String!, excludedRoundId: ID): Boolean!
  statusSummary(filter: RecruitingSeasonManagementSummaryInput): RecruitingStatusSummary!
}

type RecruitingSeasonTrackQuota {
  track: ChallengerTrack!
  targetCount: Int!
}

"""Recruiting이 외부에 제공하는 canonical round resource."""
type RecruitingRound {
  id: ID!
  season: RecruitingSeason!
  title: String!
  type: RecruitingRoundType!
  roundNo: Int
  status: RecruitingRoundStatus!
  recruitableTracks: [ChallengerTrack!]!
  secondChoiceEnabled: Boolean!
  documentStartAt: Instant!
  documentEndAt: Instant!
  documentResultPublishedAt: Instant!
  interviewRequired: Boolean!
  interviewStartAt: Instant
  interviewEndAt: Instant
  finalResultPublishedAt: Instant!
  announcement: String
  contactText: String
  applicationOpen: Boolean!
  applicationForm: RecruitingApplicationForm
  formStructure(input: RecruitingApplicationFormStructureInput!): RecruitingApplicationFormStructure
  """Recruitment READ 권한이 있을 때만 제공하는 운영 정보."""
  management: RecruitingRoundManagement
}

type RecruitingRoundManagement {
  availabilityFormId: ID
  evaluators: [MemberPublic!]!
  interviewQuestions: [RecruitingRoundInterviewQuestion!]!
  applications(
    filter: RecruitingApplicationSearchInput
    page: PageInput
  ): RecruitingApplicationPage!
}

type RecruitingApplicationForm {
  id: ID!
  formId: ID!
  status: RecruitingApplicationFormStatus!
}

"""Form 원본을 지원자의 트랙 선택에 맞게 필터링한 Recruiting projection."""
type RecruitingApplicationFormStructure {
  formId: ID!
  createdMemberId: ID!
  title: String!
  description: String
  status: FormStatus!
  anonymous: Boolean!
  allowDuplicateResponses: Boolean!
  createdAt: Instant!
  updatedAt: Instant!
  sections: [RecruitingFormSection!]!
}

type RecruitingFormSection {
  sectionId: ID!
  title: String!
  description: String
  orderNo: Int!
  questions: [RecruitingFormQuestion!]!
}

type RecruitingFormQuestion {
  questionId: ID!
  title: String!
  description: String
  type: QuestionType!
  required: Boolean!
  orderNo: Int!
  options: [RecruitingFormQuestionOption!]!
}

type RecruitingFormQuestionOption {
  optionId: ID!
  content: String!
  orderNo: Int!
  other: Boolean!
  nextSectionId: ID
}

"""Recruiting이 외부에 제공하는 canonical application resource."""
type RecruitingApplication {
  id: ID!
  round: RecruitingRound!
  status: RecruitingApplicationStatus!
  registrationStatus: RecruitingApplicationRegistrationStatus!
  firstChoice: ChallengerTrack!
  secondChoice: ChallengerTrack
  acceptedTrack: ChallengerTrack
  """지원자 본인 또는 올바른 비회원 credential에만 제공한다."""
  private: RecruitingApplicationPrivate
  """Recruitment 운영자 또는 이 round의 평가자에게만 제공한다."""
  review: RecruitingApplicationReview
}

type RecruitingApplicationPrivate {
  applicantName: String!
  applicantEmail: String!
  submitted: Boolean!
  cancelled: Boolean!
  editable: Boolean!
  documentResult: RecruitingPublicResultStatus!
  finalResult: RecruitingPublicResultStatus!
  answers: [RecruitingApplicationAnswer!]!
  interviewSchedule: RecruitingInterviewSchedule
}

type RecruitingApplicationReview {
  applicantName: String!
  applicantEmail: String!
  applicant: MemberPublic
  submittedAt: Instant
  formResponseId: ID!
  documentEvaluatedByMe: Boolean!
  interviewEvaluatedByMe: Boolean!
  answers: [RecruitingApplicationReviewAnswer!]!
  interviewQuestions: [RecruitingApplicationInterviewQuestion!]!
  evaluations(stage: RecruitingEvaluatorStage!): [RecruitingApplicationEvaluation!]!
  interviewSchedule: RecruitingInterviewSchedule
}

type RecruitingApplicationPage {
  content: [RecruitingApplication!]!
  pageInfo: PageInfo!
}

type RecruitingApplicationAnswer {
  questionId: ID!
  textValue: String
  selectedOptionIds: [ID!]!
  fileIds: [String!]!
  times: [Instant!]!
}

type RecruitingApplicationReviewAnswer {
  questionId: ID!
  type: QuestionType!
  textValue: String
  selectedOptions: [RecruitingApplicationReviewSelectedOption!]!
  fileIds: [String!]!
  times: [Instant!]!
}

type RecruitingApplicationReviewSelectedOption {
  questionOptionId: ID
  answeredAsContent: String!
}

type RecruitingRoundInterviewQuestion {
  id: ID!
  content: String!
  orderNo: Int!
}

type RecruitingApplicationInterviewQuestion {
  id: ID!
  content: String!
  orderNo: Int!
}

type RecruitingApplicationEvaluation {
  id: ID!
  evaluator: MemberPublic!
  stage: RecruitingEvaluatorStage!
  decision: RecruitingApplicationEvaluationDecision!
  comment: String
  submittedAt: Instant!
}

type RecruitingInterviewSchedule {
  id: ID!
  status: RecruitingInterviewScheduleStatus!
  startsAt: Instant
  endsAt: Instant
  location: String
  contactSnapshot: String!
}

type RecruitingStatusSummary {
  totalCount: Long!
  countByStatus: [RecruitingStatusCount!]!
  schools: [RecruitingSchoolStatusSummary!]!
}

type RecruitingSchoolStatusSummary {
  school: School!
  chapterId: ID!
  chapterName: String!
  totalCount: Long!
  countByStatus: [RecruitingStatusCount!]!
  rounds: [RecruitingRoundStatusSummary!]!
}

type RecruitingRoundStatusSummary {
  roundId: ID!
  roundTitle: String!
  roundType: RecruitingRoundType!
  roundNo: Int!
  totalCount: Long!
  countByStatus: [RecruitingStatusCount!]!
}

type RecruitingStatusCount {
  status: RecruitingApplicationStatus!
  count: Long!
}

type RecruitingApplicationCreatedPayload {
  application: RecruitingApplication!
  """비회원 생성일 때만 한 번 반환하는 재접근 credential."""
  credential: RecruitingApplicationCredential
}

type RecruitingApplicationCredential {
  email: String!
  applicationKey: String!
}

type RecruitingDeletedPayload {
  deletedId: ID!
}

enum RecruitingRoundType {
  REGULAR
  ADDITIONAL
}

enum RecruitingRoundStatus {
  DRAFT
  OPEN
  CLOSED
}

enum RecruitingApplicationFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RecruitingApplicationStatus {
  DRAFT
  SUBMITTED
  DOCUMENT_FAILED
  INTERVIEW_ASSIGNED
  INTERVIEW_SKIPPED
  FINAL_PASSED
  FINAL_FAILED
  CANCELLED
}

enum RecruitingApplicationRegistrationStatus {
  NOT_READY
  READY
  REGISTERED
}

enum RecruitingDecisionStatus {
  PASS
  FAIL
}

enum RecruitingEvaluatorStage {
  DOCUMENT
  INTERVIEW
}

enum RecruitingApplicationEvaluationDecision {
  APPROVED
  REJECTED
}

enum RecruitingFormSectionType {
  COMMON
  TRACK
}

enum RecruitingInterviewScheduleStatus {
  AVAILABILITY_REQUESTED
  AVAILABILITY_SUBMITTED
  CONFIRMED
  CANCELLED
}

enum RecruitingRoundPhase {
  OPEN
  PAST
}

enum RecruitingRoundSort {
  NEWEST
  REGISTERED
  RECRUITMENT
}

enum RecruitingPublicResultStatus {
  PENDING
  APPROVED
  REJECTED
}
