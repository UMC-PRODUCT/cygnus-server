extend type Query {
  """조건에 맞는 Gisu와 하위 Chapter·School 조직도를 조회한다."""
  gisuOrganizations(input: GisuOrganizationInput!): GisuOrganizationPayload!
  """Gisu 식별자로 표준 Gisu 응답을 조회한다."""
  gisu(id: ID!): Gisu!
  """현재 활성 Gisu를 조회한다."""
  activeGisu: Gisu!
  """전체 Chapter 표준 응답을 조회한다."""
  chapters: [Chapter!]!
  """Chapter 식별자로 표준 Chapter 응답을 조회한다."""
  chapter(id: ID!): Chapter!
  """전체 School 표준 응답을 조회한다."""
  schools: [School!]!
  """School 식별자로 표준 School 응답을 조회한다."""
  school(id: ID!): School!
  """현재 사용자가 관리할 수 있는 StudyGroup을 cursor 이후부터 조회한다."""
  managedStudyGroups(cursor: ID, size: Int = 20): [StudyGroup!]!
  """권한이 있는 StudyGroup의 상세 resource를 조회한다."""
  studyGroup(id: ID!): StudyGroup!
  """현재 UMC PRODUCT 조직도를 조회한다."""
  umcProductOrganizationChart: UmcProductOrganizationChart!
  """UMC PRODUCT 멤버를 조건과 페이지로 조회한다."""
  umcProductMembers(
    filter: UmcProductMemberFilter
    page: PageInput
  ): UmcProductMemberPage!
  """UMC PRODUCT 멤버 식별자로 상세 resource를 조회한다."""
  umcProductMember(id: ID!): UmcProductMember!
  """UMC PRODUCT Squad 목록을 조회한다."""
  umcProductSquads(filter: UmcProductSquadFilter): [UmcProductSquad!]!
}

"""Gisu 조직도 검색 조건."""
input GisuOrganizationInput {
  """조회할 Gisu 식별자 목록."""
  ids: [ID!]
  """조회할 기수 번호 목록."""
  generations: [ID!]
  """활성 상태 필터."""
  active: Boolean
}

input UmcProductMemberFilter {
  chapterId: ID
  leadershipRole: UmcProductLeadershipRole
  position: UmcProductPosition
  squadId: ID
  activeOn: LocalDate
}

input UmcProductSquadFilter {
  active: Boolean
  activeOn: LocalDate
}
