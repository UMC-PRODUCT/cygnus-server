"""Gisu 조직도 조회 결과."""
type GisuOrganizationPayload {
  gisus: [Gisu!]!
}

"""Organization 도메인이 표준으로 제공하는 기수 응답."""
type Gisu {
  id: ID!
  """사람이 인식하는 기수 번호."""
  generation: ID!
  startAt: Instant!
  endAt: Instant!
  active: Boolean!
  """이 Gisu에 편성된 Chapter 목록."""
  chapters: [Chapter!]!
  """이 Gisu에 참여한 School 목록."""
  schools: [School!]!
}

"""Organization 도메인이 표준으로 제공하는 지부 응답."""
type Chapter {
  id: ID!
  name: String!
  """이 Chapter에 소속된 School 목록."""
  schools: [School!]!
}

"""Organization 도메인이 표준으로 제공하는 학교 응답."""
type School {
  id: ID!
  name: String!
  remark: String
  logoImageUrl: String
  links: [SchoolLink!]!
  active: Boolean!
  createdAt: Instant!
  updatedAt: Instant!
}

"""School의 외부 채널 링크."""
type SchoolLink {
  title: String
  type: SchoolLinkType!
  url: String!
}

"""School 외부 채널 종류."""
enum SchoolLinkType {
  KAKAO
  YOUTUBE
  INSTAGRAM
}

"""기수 안에서 운영되는 파트별 StudyGroup."""
type StudyGroup {
  groupId: ID!
  name: String!
  gisu: Gisu!
  part: ChallengerPart!
  createdAt: Instant!
  mentors: [MemberPublic!]!
  members: [MemberPublic!]!
}

"""현재 UMC PRODUCT 조직 구성."""
type UmcProductOrganizationChart {
  chapters: [UmcProductChapter!]!
  squads: [UmcProductSquad!]!
}

type UmcProductChapter {
  chapterId: ID!
  code: String!
  name: String!
  description: String
  sortOrder: Int!
  active: Boolean!
}

type UmcProductSquad {
  squadId: ID!
  code: String!
  name: String!
  description: String
  startDate: LocalDate!
  endDate: LocalDate
  sortOrder: Int!
  active: Boolean!
}

type UmcProductMemberPage {
  content: [UmcProductMember!]!
  pageInfo: PageInfo!
}

type UmcProductMember {
  umcProductMemberId: ID!
  member: MemberPublic!
  introduction: String
  umcProductProfileImageId: String
  umcProductProfileImageUrl: String
  activityPeriods: [UmcProductMemberActivityPeriod!]!
  chapterMemberships: [UmcProductChapterMembership!]!
  productLeaderships: [UmcProductLeadership!]!
  squadParticipations: [UmcProductSquadParticipation!]!
}

type UmcProductMemberActivityPeriod {
  activityPeriodId: ID!
  startDate: LocalDate!
  endDate: LocalDate
}

type UmcProductChapterMembership {
  chapterMembershipId: ID!
  activityPeriodId: ID!
  chapter: UmcProductChapter!
  position: UmcProductPosition!
  positionName: String!
  responsibilityTitle: String
  responsibilityDescription: String
  startDate: LocalDate!
  endDate: LocalDate
}

type UmcProductLeadership {
  leadershipId: ID!
  activityPeriodId: ID!
  role: UmcProductLeadershipRole!
  roleName: String!
  startDate: LocalDate!
  endDate: LocalDate
}

type UmcProductSquadParticipation {
  squadParticipantId: ID!
  activityPeriodId: ID!
  squad: UmcProductSquad!
  role: UmcProductSquadRole!
  roleName: String!
  position: UmcProductPosition!
  positionName: String!
  responsibilityTitle: String
  responsibilityDescription: String
  startDate: LocalDate!
  endDate: LocalDate
}

enum UmcProductPosition {
  UNSPECIFIED
  PRODUCT_OWNER
  PRODUCT_DESIGNER
  IOS_DEVELOPER
  ANDROID_DEVELOPER
  WEB_DEVELOPER
  SERVER_DEVELOPER
  ETC
}

enum UmcProductSquadRole {
  MEMBER
  SQUAD_LEAD
}

enum UmcProductLeadershipRole {
  UMC_PRODUCT_VICE_LEAD
  UMC_PRODUCT_LEAD
}
