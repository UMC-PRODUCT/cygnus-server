"""0부터 시작하는 offset pagination 요청."""
input PageInput {
  """0부터 시작하는 페이지 번호."""
  page: Int = 0
  """한 페이지에서 조회할 항목 수. 1 이상 100 이하."""
  size: Int = 20
}

"""Offset pagination 결과에 공통으로 제공하는 페이지 정보."""
type PageInfo {
  """현재 페이지 번호."""
  page: Int!
  """요청에 적용된 페이지 크기."""
  size: Int!
  """조건에 맞는 전체 항목 수."""
  totalElements: Long!
  """전체 페이지 수."""
  totalPages: Int!
  """다음 페이지가 존재하는지 여부."""
  hasNext: Boolean!
}
