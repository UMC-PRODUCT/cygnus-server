"""Member 검색 결과 페이지."""
type MemberSearchPage {
  content: [MemberSearchEdge!]!
  pageInfo: PageInfo!
}

"""Member resource와 검색 문맥에서만 계산되는 정보를 분리한 edge."""
type MemberSearchEdge {
  member: MemberPublic!
  """운영자 검색 화면에 제공하는 마스킹된 이메일."""
  maskedEmail: String
  currentChallenger: MemberChallenger
  isAdminInActiveGisu: Boolean!
}

"""Member 도메인이 표준으로 제공하는 공개 회원 응답."""
type MemberPublic {
  memberId: ID!
  name: String
  nickname: String
  """Organization School을 조회하기 위한 식별자."""
  schoolId: ID
  """Member 저장 시점의 학교명 문자열. 최신 학교 정보는 school field를 사용한다."""
  schoolName: String
  profileImageLink: String
  """schoolId로 연결한 Organization 도메인의 표준 School 응답."""
  school: School
  """Challenger 도메인 정보를 Member 조회 문맥에 맞게 변환한 활동 이력."""
  challengers: [MemberChallenger!]!
  """본인에게만 제공하는 Member 비공개 정보."""
  private: MemberPrivate
}

"""Member 본인에게만 제공하는 비공개 정보."""
type MemberPrivate {
  email: String!
  status: MemberStatus!
}

"""Member account lifecycle 상태."""
enum MemberStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

"""Challenger 정보를 Member 조회 문맥에 맞게 변환한 응답."""
type MemberChallenger {
  challengerId: ID!
  memberId: ID!
  gisuId: ID!
  """gisuId로 연결한 Organization 도메인의 표준 Gisu 응답."""
  gisu: Gisu
  part: ChallengerPart
  tracks: [ChallengerTrack!]!
  status: ChallengerStatus!
}
