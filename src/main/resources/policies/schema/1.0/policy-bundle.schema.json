{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umc:authorization:policy-bundle:1.0",
  "title": "UMC Policy Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contextSchemaVersion",
    "namespace",
    "policyVersion",
    "defaultEffect",
    "combiningAlgorithm",
    "modules"
  ],
  "properties": {
    "$schema": {
      "const": "urn:umc:authorization:policy-bundle:1.0"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "contextSchemaVersion": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string"
    },
    "defaultEffect": {
      "const": "DENY"
    },
    "combiningAlgorithm": {
      "const": "DENY_OVERRIDES"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resource"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          }
        }
      }
    }
  }
}
