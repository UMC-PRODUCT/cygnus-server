{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umc:authorization:domain-coverage:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domains"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "classification", "migrationStatus", "reason"],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "classification": {
            "enum": [
              "POLICY_MANAGED",
              "AUTHENTICATION_BOUNDARY",
              "INTERNAL_ONLY",
              "NO_ACTOR_AUTHORIZATION",
              "INFRASTRUCTURE"
            ]
          },
          "migrationStatus": {
            "enum": ["PLANNED", "SHADOW", "ENFORCED", "EXEMPT"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
