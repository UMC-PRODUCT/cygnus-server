      "effect": "ALLOW",
      "actions": [
        "notification:send-fcm"
      ],
      "condition": {
        "type": "PREDICATE",
        "operator": "EQ",
        "left": {
          "type": "ATTRIBUTE",
          "name": "relation.activeCentralCore"
        },
        "right": {
          "type": "BOOLEAN",
          "value": true
        }
      },
      "outcomes": []
    },
    {
      "id": "notification.delete-token.active-central-core",
      "effect": "ALLOW",
