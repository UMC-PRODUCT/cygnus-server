{
  "$schema": "urn:umc:authorization:policy-module:1.0",
  "schemaVersion": "1.0",
  "contextSchemaVersion": "notification-1.0",
  "namespace": "notification",
  "policyVersion": "1.0.0",
  "moduleId": "notification-resource",
  "statements": [
    {
