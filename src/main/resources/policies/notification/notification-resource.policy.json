        "notification:delete-token"
      ],
      "condition": {
        "type": "PREDICATE",
        "operator": "EQ",
        "left": {
          "type": "ATTRIBUTE",
          "name": "relation.activeCentralCore"
        },
        "right": {
          "type": "BOOLEAN",
          "value": true
        }
      },
      "outcomes": []
    },
    {
      "id": "notification.delete-token.owner",
      "effect": "ALLOW",
      "actions": [
        "notification:delete-token"
      ],
      "condition": {
        "type": "PREDICATE",
        "operator": "EQ",
        "left": {
          "type": "ATTRIBUTE",
          "name": "relation.isTokenOwner"
        },
        "right": {
          "type": "BOOLEAN",
          "value": true
